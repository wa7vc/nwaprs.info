{#
  Renders a Good/Better/Best row of solution cards.
  Usage: {% import "components/solution-tiers.njk" as solutionTiers %}
         {{ solutionTiers.render(category.tiers) }}
#}
{% macro render(items) %}
  <div class="mt-4 grid gap-4 sm:grid-cols-3">
    {% for item in items %}
      <div class="rounded-lg border border-slate-200 p-4">
        <p class="text-xs font-bold uppercase tracking-widest {{ 'text-beacon-700' if item.tier == 'Best' else ('text-signal-700' if item.tier == 'Better' else 'text-slate-500') }}">
          {{ item.tier }}
        </p>
        <h3 class="mt-1 font-semibold text-night-950">{{ item.title }}</h3>
        <p class="mt-2 text-sm text-slate-600">{{ item.description }}</p>
      </div>
    {% endfor %}
  </div>
{% endmacro %}
